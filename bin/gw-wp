#!/usr/bin/env python3
"""
gw-wp: Gary Wallage Photography WordPress Multisite & Bookly Management Toolkit.
Allows drafting, editing, querying, and managing pages, posts, meta, media, Bookly configuration, and blocks across all multisite subdomains.
"""

import sys
import os
import subprocess
import json
import argparse

SITE_ALIASES = {
    "staging": "https://staging.garywallage.uk/",
    "wedding": "https://wedding.garywallage.uk/",
    "family": "http://family.garywallage.uk/",
    "fashion": "http://fashion.garywallage.uk/",
    "cosplay": "http://cosplay.garywallage.uk/",
    "glamour": "http://glamour.garywallage.uk/",
    "boudoir": "http://boudoir.garywallage.uk/",
    "1": "https://staging.garywallage.uk/",
    "2": "https://wedding.garywallage.uk/",
    "3": "http://family.garywallage.uk/",
    "4": "http://fashion.garywallage.uk/",
    "5": "http://cosplay.garywallage.uk/",
    "6": "http://glamour.garywallage.uk/",
    "7": "http://boudoir.garywallage.uk/",
}

def get_container_id():
    try:
        out = subprocess.check_output(
            ["docker", "ps", "--filter", "name=gary-portfolio_wordpress", "--format", "{{.ID}}"],
            text=True
        ).strip().splitlines()
        if out:
            return out[0]
    except Exception as e:
        print(f"Error locating WordPress container: {e}", file=sys.stderr)
    return None

def run_wp_cli(args, site=None, input_data=None, as_json=False):
    container_id = get_container_id()
    if not container_id:
        print("Error: WordPress container is not running.", file=sys.stderr)
        sys.exit(1)

    url = SITE_ALIASES.get(site.lower(), site) if site else None
    cmd = ["docker", "exec", "-i", "-u", "sickchill", container_id, "wp"]
    if url:
        cmd.extend(["--url=" + url])
    cmd.extend(args)

    if as_json and "--format=json" not in cmd:
        cmd.append("--format=json")

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE if input_data is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        stdout, stderr = proc.communicate(input=input_data)
        if proc.returncode != 0:
            if stderr:
                print(f"WP-CLI Error: {stderr.strip()}", file=sys.stderr)
            sys.exit(proc.returncode)
        
        if as_json:
            try:
                return json.loads(stdout)
            except json.JSONDecodeError:
                return stdout
        return stdout
    except Exception as e:
        print(f"Command execution error: {e}", file=sys.stderr)
        sys.exit(1)

# ==================== CLI COMMAND HANDLERS ====================

def cmd_site_list(args):
    res = run_wp_cli(["site", "list"], as_json=args.json)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(res)

def cmd_page_list(args):
    wp_args = ["post", "list", f"--post_type={args.type}", f"--posts_per_page={args.limit}"]
    if args.status:
        wp_args.append(f"--post_status={args.status}")
    if args.search:
        wp_args.append(f"--s={args.search}")
    res = run_wp_cli(wp_args, site=args.site, as_json=args.json)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(res)

def cmd_page_get(args):
    if args.field == "meta":
        res = run_wp_cli(["post", "meta", "list", str(args.id)], site=args.site, as_json=args.json)
    else:
        field_flag = f"--field={args.field}" if args.field != "all" else None
        wp_args = ["post", "get", str(args.id)]
        if field_flag:
            wp_args.append(field_flag)
        res = run_wp_cli(wp_args, site=args.site, as_json=args.json)
    if args.json and not isinstance(res, str):
        print(json.dumps(res, indent=2))
    else:
        print(res)

def cmd_page_create(args):
    content = ""
    if args.file:
        with open(args.file, "r", encoding="utf-8") as f:
            content = f.read()
    elif args.content:
        content = args.content

    wp_args = [
        "post", "create",
        f"--post_type={args.type}",
        f"--post_title={args.title}",
        f"--post_status={args.status}",
        "--porcelain"
    ]
    if args.slug:
        wp_args.append(f"--post_name={args.slug}")
    if args.template:
        wp_args.append(f"--page_template={args.template}")

    post_id = run_wp_cli(wp_args, site=args.site, input_data=content if content else None).strip()
    if content:
        run_wp_cli(["post", "update", post_id, "--post_content=-"], site=args.site, input_data=content)

    print(f"Created {args.type} #{post_id} on [{args.site}]")
    return post_id

def cmd_page_update(args):
    wp_args = ["post", "update", str(args.id)]
    content = None
    if args.file:
        with open(args.file, "r", encoding="utf-8") as f:
            content = f.read()
        wp_args.append("--post_content=-")
    elif args.content is not None:
        content = args.content
        wp_args.append("--post_content=-")

    if args.title:
        wp_args.append(f"--post_title={args.title}")
    if args.slug:
        wp_args.append(f"--post_name={args.slug}")
    if args.status:
        wp_args.append(f"--post_status={args.status}")
    if args.template:
        wp_args.append(f"--page_template={args.template}")

    res = run_wp_cli(wp_args, site=args.site, input_data=content)
    print(f"Updated post #{args.id} on [{args.site}]")

def cmd_meta_get(args):
    if args.key:
        res = run_wp_cli(["post", "meta", "get", str(args.post_id), args.key], site=args.site)
        print(res.strip())
    else:
        res = run_wp_cli(["post", "meta", "list", str(args.post_id)], site=args.site, as_json=args.json)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(res)

def cmd_meta_set(args):
    res = run_wp_cli(["post", "meta", "set", str(args.post_id), args.key, args.value], site=args.site)
    print(f"Set meta '{args.key}' on post #{args.post_id}")

def cmd_meta_delete(args):
    res = run_wp_cli(["post", "meta", "delete", str(args.post_id), args.key], site=args.site)
    print(f"Deleted meta '{args.key}' on post #{args.post_id}")

def cmd_bookly_services(args):
    site_url = SITE_ALIASES.get(args.site.lower(), args.site)
    # Determine table prefix from blog ID
    blog_res = run_wp_cli(["eval", "echo get_current_blog_id();"], site=args.site).strip()
    prefix = f"wp_{blog_res}_" if blog_res != "1" else "wp_"
    
    query = f"""
    SELECT 
        s.id, s.title, s.price, s.duration, c.name AS category, s.type, s.visibility
    FROM {prefix}bookly_services s
    LEFT JOIN {prefix}bookly_categories c ON s.category_id = c.id
    ORDER BY s.position ASC, s.id ASC;
    """
    res = run_wp_cli(["db", "query", query], site=args.site)
    print(res)

def cmd_bookly_get(args):
    blog_res = run_wp_cli(["eval", "echo get_current_blog_id();"], site=args.site).strip()
    prefix = f"wp_{blog_res}_" if blog_res != "1" else "wp_"

    query = f"SELECT * FROM {prefix}bookly_services WHERE id = {int(args.id)};"
    service = run_wp_cli(["db", "query", query], site=args.site)
    print("=== BOOKLY SERVICE ===")
    print(service)

    sub_query = f"""
    SELECT sub.id, sub.sub_service_id, s.title, s.price, s.duration
    FROM {prefix}bookly_sub_services sub
    JOIN {prefix}bookly_services s ON sub.sub_service_id = s.id
    WHERE sub.service_id = {int(args.id)};
    """
    subs = run_wp_cli(["db", "query", sub_query], site=args.site)
    print("=== COMPOUND SUB-SERVICES ===")
    print(subs)

def cmd_bookly_set_price(args):
    blog_res = run_wp_cli(["eval", "echo get_current_blog_id();"], site=args.site).strip()
    prefix = f"wp_{blog_res}_" if blog_res != "1" else "wp_"

    query = f"UPDATE {prefix}bookly_services SET price = {float(args.price)} WHERE id = {int(args.id)};"
    run_wp_cli(["db", "query", query], site=args.site)
    print(f"Updated Bookly Service #{args.id} price to £{float(args.price):.2f}")

def cmd_bookly_set_duration(args):
    blog_res = run_wp_cli(["eval", "echo get_current_blog_id();"], site=args.site).strip()
    prefix = f"wp_{blog_res}_" if blog_res != "1" else "wp_"

    query = f"UPDATE {prefix}bookly_services SET duration = {int(args.duration)} WHERE id = {int(args.id)};"
    run_wp_cli(["db", "query", query], site=args.site)
    print(f"Updated Bookly Service #{args.id} duration to {int(args.duration)} seconds ({int(args.duration)/3600:.1f} hours)")

def cmd_media_list(args):
    wp_args = ["post", "list", "--post_type=attachment", f"--posts_per_page={args.limit}"]
    res = run_wp_cli(wp_args, site=args.site, as_json=args.json)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(res)

def cmd_media_import(args):
    wp_args = ["media", "import", args.file, "--porcelain"]
    if args.title:
        wp_args.append(f"--title={args.title}")
    if args.alt:
        wp_args.append(f"--alt={args.alt}")
    if args.post_id:
        wp_args.append(f"--post_id={args.post_id}")
    if args.featured:
        wp_args.append("--featured_image")
    
    media_id = run_wp_cli(wp_args, site=args.site).strip()
    print(f"Imported Media ID #{media_id} on [{args.site}]")
    return media_id

def cmd_cache_purge(args):
    sites = [args.site] if args.site != "all" else ["wedding", "staging", "family", "fashion", "cosplay", "glamour", "boudoir"]
    for s in sites:
        run_wp_cli(["cache", "flush"], site=s)
        run_wp_cli(["rewrite", "flush"], site=s)
        print(f"Cache flushed for [{s}]")

def cmd_theme_bump(args):
    theme_dir = "/opt/docker-stacks/gary-portfolio/html/wp-content/themes/gary-wedding-pro"
    style_css = os.path.join(theme_dir, "style.css")
    new_version = args.version

    if not new_version:
        # Read current version from style.css and bump minor
        with open(style_css, "r") as f:
            for line in f:
                if "Version:" in line:
                    cur = line.split("Version:")[1].strip()
                    parts = cur.split(".")
                    if len(parts) == 3:
                        new_version = f"{parts[0]}.{int(parts[1])+1}.{parts[2]}"
                    break
        if not new_version:
            new_version = "3000.71.0"

    print(f"Bumping theme version to {new_version}...")
    # Update style.css
    with open(style_css, "r") as f:
        content = f.read()
    import re
    content = re.sub(r'(\*\s*Version:\s*)([0-9\.]+)', f'\\g<1>{new_version}', content)
    with open(style_css, "w") as f:
        f.write(content)

    print(f"Theme version successfully bumped to {new_version}")

def cmd_block_generate(args):
    t = args.template.lower()
    if t == "z-pattern":
        direction = " is-right" if args.reverse else ""
        print(f"""<!-- wp:group {{"className":"gw-z-pattern{direction}"}} -->
<div class="wp-block-group gw-z-pattern{direction}">
    <div class="gw-z-image">
        <img src="{args.image or 'https://wedding.garywallage.uk/wp-content/uploads/sample.jpg'}" alt="{args.title or 'Story Image'}" />
    </div>
    <div class="gw-z-content">
        <h2>{args.title or 'Editorial Section Title'}</h2>
        <p>{args.text or 'Add rich storytelling narrative here. Crafted for modern wedding editorial layout.'}</p>
        {f'<a href="{args.link}" class="btn-brand-gold">Discover More</a>' if args.link else ''}
    </div>
</div>
<!-- /wp:group -->""")
    elif t == "accordion-faq":
        print(f"""<!-- wp:heading {{"level":3,"className":"faq-question"}} -->
<h3 class="faq-question">{args.title or 'What is included in this collection?'}</h3>
<!-- /wp:heading -->
<!-- wp:paragraph {{"className":"faq-answer"}} -->
<p class="faq-answer">{args.text or 'Detailed answer answering the question with complete pricing and timeline transparency.'}</p>
<!-- /wp:paragraph -->""")
    elif t == "service-plaque":
        print(f"""<!-- wp:group {{"className":"investment-plaque"}} -->
<div class="wp-block-group investment-plaque">
    <div class="investment-plaque-inner">
        <span class="plaque-label">Investment</span>
        <div class="plaque-price">£{args.price or '1995.00'}</div>
        <p class="plaque-duration">{args.duration or 'Full Day Coverage (10.0 Hours)'}</p>
        <hr class="plaque-divider"/>
        <p class="plaque-description">{args.text or 'Includes pre-wedding consultation, complete ceremony to first dance coverage, and full high-resolution gallery.'}</p>
    </div>
</div>
<!-- /wp:group -->""")
    else:
        print(f"Unknown template '{t}'. Available: z-pattern, accordion-faq, service-plaque")

# ==================== MAIN PARSER ====================

def main():
    parser = argparse.ArgumentParser(description="gw-wp: Gary Wallage WordPress Multisite Content & Bookly CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # SITE
    p_site = subparsers.add_parser("site", help="Manage multisite network sites")
    p_site_sub = p_site.add_subparsers(dest="subcommand", required=True)
    p_site_list = p_site_sub.add_parser("list", help="List all sites")
    p_site_list.add_argument("--json", action="store_true")
    p_site_list.set_defaults(func=cmd_site_list)

    # PAGE / POST
    p_page = subparsers.add_parser("content", help="Manage pages and posts")
    p_page.add_argument("--site", default="wedding", help="Subdomain alias (wedding, staging, family, fashion, cosplay, glamour, boudoir)")
    p_page_sub = p_page.add_subparsers(dest="subcommand", required=True)
    
    p_page_list = p_page_sub.add_parser("list", help="List pages or posts")
    p_page_list.add_argument("--type", default="page", help="Post type (page, post, visual_legacies)")
    p_page_list.add_argument("--status", default=None, help="publish, draft, trash, any")
    p_page_list.add_argument("--limit", type=int, default=50)
    p_page_list.add_argument("--search", default=None)
    p_page_list.add_argument("--json", action="store_true")
    p_page_list.set_defaults(func=cmd_page_list)

    p_page_get = p_page_sub.add_parser("get", help="Get post/page content or fields")
    p_page_get.add_argument("id", type=int)
    p_page_get.add_argument("--field", default="content", help="content, post_title, meta, all")
    p_page_get.add_argument("--json", action="store_true")
    p_page_get.set_defaults(func=cmd_page_get)

    p_page_create = p_page_sub.add_parser("create", help="Create page or post")
    p_page_create.add_argument("--title", required=True)
    p_page_create.add_argument("--type", default="page")
    p_page_create.add_argument("--slug", default=None)
    p_page_create.add_argument("--status", default="draft")
    p_page_create.add_argument("--template", default=None)
    p_page_create.add_argument("--file", default=None)
    p_page_create.add_argument("--content", default=None)
    p_page_create.set_defaults(func=cmd_page_create)

    p_page_update = p_page_sub.add_parser("update", help="Update page or post")
    p_page_update.add_argument("id", type=int)
    p_page_update.add_argument("--title", default=None)
    p_page_update.add_argument("--slug", default=None)
    p_page_update.add_argument("--status", default=None)
    p_page_update.add_argument("--template", default=None)
    p_page_update.add_argument("--file", default=None)
    p_page_update.add_argument("--content", default=None)
    p_page_update.set_defaults(func=cmd_page_update)

    # META
    p_meta = subparsers.add_parser("meta", help="Manage custom post meta")
    p_meta.add_argument("--site", default="wedding")
    p_meta_sub = p_meta.add_subparsers(dest="subcommand", required=True)
    
    p_meta_get = p_meta_sub.add_parser("get", help="Get post meta")
    p_meta_get.add_argument("post_id", type=int)
    p_meta_get.add_argument("key", nargs="?", default=None)
    p_meta_get.add_argument("--json", action="store_true")
    p_meta_get.set_defaults(func=cmd_meta_get)

    p_meta_set = p_meta_sub.add_parser("set", help="Set post meta")
    p_meta_set.add_argument("post_id", type=int)
    p_meta_set.add_argument("key")
    p_meta_set.add_argument("value")
    p_meta_set.set_defaults(func=cmd_meta_set)

    p_meta_del = p_meta_sub.add_parser("delete", help="Delete post meta")
    p_meta_del.add_argument("post_id", type=int)
    p_meta_del.add_argument("key")
    p_meta_del.set_defaults(func=cmd_meta_delete)

    # BOOKLY
    p_bookly = subparsers.add_parser("bookly", help="Manage Bookly services, categories, and pricing")
    p_bookly.add_argument("--site", default="wedding")
    p_bookly_sub = p_bookly.add_subparsers(dest="subcommand", required=True)

    p_bookly_list = p_bookly_sub.add_parser("services", help="List Bookly services")
    p_bookly_list.set_defaults(func=cmd_bookly_services)

    p_bookly_get = p_bookly_sub.add_parser("get", help="Get Bookly service details")
    p_bookly_get.add_argument("id", type=int)
    p_bookly_get.set_defaults(func=cmd_bookly_get)

    p_bookly_price = p_bookly_sub.add_parser("set-price", help="Set Bookly service price")
    p_bookly_price.add_argument("id", type=int)
    p_bookly_price.add_argument("price", type=float)
    p_bookly_price.set_defaults(func=cmd_bookly_set_price)

    p_bookly_dur = p_bookly_sub.add_parser("set-duration", help="Set Bookly duration in seconds")
    p_bookly_dur.add_argument("id", type=int)
    p_bookly_dur.add_argument("duration", type=int)
    p_bookly_dur.set_defaults(func=cmd_bookly_set_duration)

    # MEDIA
    p_media = subparsers.add_parser("media", help="Manage WordPress media attachments")
    p_media.add_argument("--site", default="wedding")
    p_media_sub = p_media.add_subparsers(dest="subcommand", required=True)

    p_media_list = p_media_sub.add_parser("list", help="List media attachments")
    p_media_list.add_argument("--limit", type=int, default=20)
    p_media_list.add_argument("--json", action="store_true")
    p_media_list.set_defaults(func=cmd_media_list)

    p_media_import = p_media_sub.add_parser("import", help="Import media file")
    p_media_import.add_argument("file", help="Path to image file")
    p_media_import.add_argument("--title", default=None)
    p_media_import.add_argument("--alt", default=None)
    p_media_import.add_argument("--post_id", type=int, default=None)
    p_media_import.add_argument("--featured", action="store_true")
    p_media_import.set_defaults(func=cmd_media_import)

    # CACHE & THEME
    p_cache = subparsers.add_parser("cache", help="Manage cache and theme version")
    p_cache_sub = p_cache.add_subparsers(dest="subcommand", required=True)

    p_cache_purge = p_cache_sub.add_parser("purge", help="Purge Redis object cache & rewrites")
    p_cache_purge.add_argument("--site", default="wedding")
    p_cache_purge.set_defaults(func=cmd_cache_purge)

    p_theme_bump = p_cache_sub.add_parser("bump-theme", help="Bump theme version")
    p_theme_bump.add_argument("--version", default=None)
    p_theme_bump.set_defaults(func=cmd_theme_bump)

    # BLOCKS
    p_block = subparsers.add_parser("block", help="Generate Gutenberg block markup")
    p_block_sub = p_block.add_subparsers(dest="subcommand", required=True)

    p_block_gen = p_block_sub.add_parser("generate", help="Generate block HTML")
    p_block_gen.add_argument("template", help="z-pattern, accordion-faq, service-plaque")
    p_block_gen.add_argument("--title", default=None)
    p_block_gen.add_argument("--text", default=None)
    p_block_gen.add_argument("--image", default=None)
    p_block_gen.add_argument("--link", default=None)
    p_block_gen.add_argument("--price", default=None)
    p_block_gen.add_argument("--duration", default=None)
    p_block_gen.add_argument("--reverse", action="store_true")
    p_block_gen.set_defaults(func=cmd_block_generate)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
